<Window x:Class="BluetoothTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:models="clr-namespace:BluetoothTool.Models"
        xmlns:behaviors="clr-namespace:BluetoothTool.Behaviors"
        xmlns:vm="clr-namespace:BluetoothTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="蓝牙调试工具"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 窗口控制按钮基础样式 -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 关闭按钮样式（悬停变红） -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 窗口加载完成后自动扫描设备 -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding RefreshDevicesCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- 窗口内容容器：圆角、边框与阴影 -->
    <Border x:Name="WindowRootBorder"
            Margin="16"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect x:Name="WindowShadow"
                              BlurRadius="16"
                              ShadowDepth="0"
                              Opacity="0.4"
                              Color="#000000" />
        </Border.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border Grid.Row="0"
                Height="44"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Path Data="M 17.71,7.71 L 12,2 L 11,2 L 11,9.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 11,14.41 L 11,22 L 12,22 L 17.71,16.29 L 13.41,12 L 17.71,7.71 Z"
                              Fill="{DynamicResource AccentBrush}"
                              Width="24" Height="24" Stretch="Uniform" />
                    </Viewbox>
                    <TextBlock Text="蓝牙调试工具"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <!-- 主题选择与窗口控制按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="主题"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="Name"
                              Width="76"
                              Margin="0,0,14,0" />

                    <TextBlock Text="强调色"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Accents}"
                              SelectedItem="{Binding SelectedAccent}"
                              DisplayMemberPath="Name"
                              Width="76"
                              Margin="0,0,14,0" />

                    <Border Width="1"
                            Height="20"
                            Background="{DynamicResource DividerBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                    <!-- 最小化 -->
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化">
                        <Path Data="M 0,5 L 10,5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>

                    <!-- 最大化 / 还原 -->
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="最大化">
                        <Grid>
                            <Path x:Name="MaximizeIcon"
                                  Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Width="10" Height="10" Stretch="Uniform" />
                            <Path x:Name="RestoreIcon"
                                  Data="M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 L 2.5,7.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <!-- 关闭 -->
                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体内容 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备管理区 -->
            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="12"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="8">
                <DockPanel>
                    <!-- 标题 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="蓝牙设备"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 底部操作按钮 -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="刷新设备"
                                Command="{Binding RefreshDevicesCommand}"
                                Height="36"
                                Margin="0,0,0,8" />

                        <!-- 配对 PIN 码 -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="配对 PIN"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     Margin="8,0,0,0"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>

                        <UniformGrid Columns="2">
                            <Button Content="连接"
                                    Command="{Binding ConnectCommand}"
                                    Height="36"
                                    Margin="0,0,4,0" />
                            <Button Content="断开"
                                    Command="{Binding DisconnectCommand}"
                                    Height="36"
                                    Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>

                    <!-- 设备列表 -->
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding IsPaired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="已配对"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Address}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：消息与音乐区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 消息日志 -->
                <Border Grid.Row="0"
                        Padding="12"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="消息日志"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding Messages}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource MessageListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="False">
                            <i:Interaction.Behaviors>
                                <behaviors:AutoScrollBehavior />
                            </i:Interaction.Behaviors>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BluetoothMessage}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontFamily="Consolas" />

                                        <TextBlock x:Name="DirectionText"
                                                   Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Content}"
                                                   Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.Sent}">
                                            <Setter TargetName="DirectionText" Property="Text" Value="[发送]" />
                                            <Setter TargetName="DirectionText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.Received}">
                                            <Setter TargetName="DirectionText" Property="Text" Value="[接收]" />
                                            <Setter TargetName="DirectionText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.System}">
                                            <Setter TargetName="DirectionText" Property="Text" Value="[系统]" />
                                            <Setter TargetName="DirectionText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 发送输入区 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Padding="8,0"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="发送"
                            Command="{Binding SendMessageCommand}"
                            Width="90"
                            Height="40"
                            Margin="10,0,0,0" />

                    <Button Grid.Column="2"
                            Content="清空"
                            Command="{Binding ClearLogCommand}"
                            Width="90"
                            Height="40"
                            Margin="10,0,0,0" />
                </Grid>

                <!-- 音乐播放区 -->
                <Border Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="12"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        CornerRadius="8">
                    <DockPanel>
                        <TextBlock Text="音乐播放"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" />

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="打开文件"
                                    Command="{Binding OpenMusicCommand}"
                                    Height="34"
                                    Margin="0,0,6,0" />
                            <Button Content="播放/暂停"
                                    Command="{Binding PlayPauseMusicCommand}"
                                    Height="34"
                                    Margin="0,0,6,0" />
                            <Button Content="停止"
                                    Command="{Binding StopMusicCommand}"
                                    Height="34" />
                        </StackPanel>

                        <TextBlock Text="{Binding MusicFilePath}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
