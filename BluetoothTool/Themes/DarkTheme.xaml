<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题基础色板 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#16181D" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1F2228" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252830" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A1C21" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2C3038" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#2E3B4A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#373B44" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2E323A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7E9EE" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA1AA" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#60666F" />

    <!-- 默认蓝色强调色（可被强调色字典覆盖） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A7BEF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F6ADB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- 接收消息颜色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FBF63" />

</ResourceDictionary>
